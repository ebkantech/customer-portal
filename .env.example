# Base URL of your existing Django REST API. Keep /api at the end.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api

# Staff CRM frontend (Vite app; its sign-in screen is "/"), NOT the Django API.
# Only used for the "Go to sign in" button after a staff member sets their
# password. Public (inlined into the browser bundle): restart/rebuild after
# changing it. When unset in production the button is hidden.
NEXT_PUBLIC_CRM_APP_URL=http://localhost:5173
